{
  "name": "nearfest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node scripts/test.mjs",
    "test:contract": "node scripts/contract-check.mjs",
    "deploy:testnet": "node --env-file-if-exists=.env scripts/deploy-testnet.mjs",
    "setup:testnet": "node --env-file-if-exists=.env scripts/setup-testnet.mjs",
    "test:testnet": "node --env-file-if-exists=.env scripts/testnet-smoke.mjs",
    "setup:faucet": "node scripts/setup-faucet.mjs",
    "test:faucet": "node scripts/check-faucet.mjs",
    "db:local": "node --env-file-if-exists=.env scripts/local-postgres.mjs",
    "db:migrate:sqlite": "node --env-file-if-exists=.env scripts/migrate-sqlite.mjs",
    "setup:accounts": "node scripts/setup-managed-accounts.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "chess.js": "1.4.0",
    "gsap": "3.15.1",
    "matter-js": "^0.20.0",
    "near-api-js": "7.5.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "8.3.8"
  }
}
