# PostgreSQL is required. Start the local server with npm run db:local.
DATABASE_URL=postgresql://nearfest:nearfest@127.0.0.1:5432/nearfest
# Optional PostgreSQL schema (defaults to public).
# DATABASE_SCHEMA=public
# Per API process: 2 query connections plus at most 1 faucet-lock connection.
DATABASE_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=5000
DATABASE_STARTUP_TIMEOUT_MS=30000
PORT=5189
APP_ORIGIN=http://127.0.0.1:5188
# NEAR testnet only. Never put secrets in VITE_ variables.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=
NEAR_ORACLE_ACCOUNT=
NEAR_ORACLE_PRIVATE_KEY=
# Used only for deploying to a NEW testnet account, then remove it.
NEAR_DEPLOY_PRIVATE_KEY=
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
# Required before enabling public deployments; supplies semantic moderation.
# Set to true to prevent user content creation without a moderation model.
REQUIRE_SEMANTIC_MODERATION=false

# Optional dedicated sponsor for the in-app testnet faucet. Never reuse escrow/oracle keys.
NEAR_FAUCET_ACCOUNT=
NEAR_FAUCET_PRIVATE_KEY=
